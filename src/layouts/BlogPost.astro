---
/**
 * BlogPost.astro — layout de un artículo del blog.
 * Renderiza: breadcrumb, H1, meta, caja de respuesta directa (AEO),
 * tabla de contenido automática (desde los H2), cuerpo (slot), FAQ y CTA.
 * Inyecta JSON-LD Article + BreadcrumbList + FAQPage vía Content → Base.
 */
import Content from './Content.astro';
import { getCollection } from 'astro:content';
import { articleSchema, faqPageSchema, breadcrumbSchema } from '../lib/schema.js';

export interface Props {
  entry: any;
  headings: { depth: number; slug: string; text: string }[];
}
const { entry, headings } = Astro.props;
const { data } = entry;

const url = `/blog/${entry.id}/`;
const fullUrl = new URL(url, 'https://santiagogil.com.mx').href;
const datePublished = data.pubDate.toISOString();
const dateModified = (data.updatedDate ?? data.pubDate).toISOString();
const fmtDate = data.pubDate.toLocaleDateString('es-MX', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const toc = headings.filter((h) => h.depth === 2);
const words = String(entry.body ?? '').split(/\s+/).filter(Boolean).length;
const readMin = Math.max(1, Math.round(words / 200));

// «Sigue leyendo»: 3 hermanos del mismo cluster + 3 rotatorios de otros
// clusters, por round-robin determinista sobre el orden de slugs. Así cada
// guía recibe ~6 enlaces internos repartidos, en vez de concentrarlos en
// las mismas seis «más recientes» en todas las páginas.
const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) =>
  a.id.localeCompare(b.id)
);
const idx = allPosts.findIndex((p) => p.id === entry.id);
const inCluster = allPosts.filter((p) => p.data.cluster === data.cluster);
const ci = inCluster.findIndex((p) => p.id === entry.id);
const siblings: typeof allPosts = [];
for (let k = 1; k < inCluster.length && siblings.length < 3; k++) {
  siblings.push(inCluster[(ci + k) % inCluster.length]);
}
const outCluster = allPosts.filter((p) => p.data.cluster !== data.cluster);
const start = (idx * 7) % outCluster.length; // stride primo → ventanas bien repartidas
const rotating: typeof allPosts = [];
for (let k = 0; k < outCluster.length && siblings.length + rotating.length < 6; k++) {
  rotating.push(outCluster[(start + k) % outCluster.length]);
}
const readNext = [...siblings, ...rotating];

const jsonLd = [
  articleSchema({
    title: data.title,
    description: data.description,
    url: fullUrl,
    datePublished,
    dateModified,
    image: data.image,
  }),
  breadcrumbSchema([
    { name: 'Inicio', url: '/' },
    { name: 'Blog', url: '/blog/' },
    { name: data.title, url },
  ]),
];
if (data.faqs && data.faqs.length) jsonLd.push(faqPageSchema(data.faqs));
---
<Content
  title={`${data.title} | Santiago Gil`}
  description={data.description}
  canonical={url}
  image={data.image}
  type="article"
  jsonLd={jsonLd}
>
  <article class="article container">
    <nav class="breadcrumb" aria-label="Ruta de navegación">
      <a href="/">Inicio</a> › <a href="/blog/">Blog</a> › <span>{data.clusterLabel}</span>
    </nav>

    <div class="page-hero" style="padding-bottom:8px;">
      <span class="eyebrow">{data.clusterLabel}</span>
      <h1>{data.title}</h1>
      <div class="article__meta">
        <span>Por Chago Gil</span>
        <span>{fmtDate}</span>
        <span>{readMin} min de lectura</span>
      </div>
    </div>

    <div class="answer-box">
      <span class="answer-box__label">Respuesta corta</span>
      {data.answer}
    </div>

    <div class="article__layout">
      <div class="prose">
        <slot />
      </div>
      {toc.length > 0 && (
        <aside class="toc" aria-label="Tabla de contenido">
          <p class="toc__title">En esta guía</p>
          <ul>
            {toc.map((h) => (
              <li><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ul>
        </aside>
      )}
    </div>

    {data.faqs && data.faqs.length > 0 && (
      <section class="faq" aria-label="Preguntas frecuentes">
        <h2>Preguntas frecuentes</h2>
        {data.faqs.map((f: { question: string; answer: string }) => (
          <details>
            <summary>{f.question}</summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </section>
    )}

    {readNext.length > 0 && (
      <section class="read-next" aria-label="Sigue leyendo" style="margin-top:48px;">
        <h2 style="font-size:1.35rem; letter-spacing:-.01em; margin:0 0 16px; padding-bottom:8px; border-bottom:1px solid var(--gray-soft);">Sigue leyendo</h2>
        <div class="card-grid">
          {readNext.map((p) => (
            <article class="card">
              {p.data.cornerstone && <span class="tag">Guía principal</span>}
              <h3><a href={`/blog/${p.id}/`}>{p.data.title}</a></h3>
              <p>{p.data.description}</p>
              <a href={`/blog/${p.id}/`}>Leer la guía →</a>
            </article>
          ))}
        </div>
      </section>
    )}

    <div class="cta-box">
      <h3>¿Tienes una marca que construir?</h3>
      <p>Branding, identidad y estrategia para negocios en crecimiento. CDMX y remoto.</p>
      <a href="/#contacto" class="btn">Hablemos</a>
    </div>
  </article>
</Content>
